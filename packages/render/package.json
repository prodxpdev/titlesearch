{
  "name": "@titlesearch/render",
  "version": "0.0.0",
  "description": "Site previews: the egress proxy, the local-chromium renderer, and image handling.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./preview-response": "./src/preview-response.ts",
    "./image-codec": "./src/image-codec.ts",
    "./previewer": "./src/previewer.ts",
    "./remote": "./src/remote.ts",
    "./renderer": "./src/renderer.ts",
    "./cloudflare": "./src/cloudflare.ts",
    "./page-capture": "./src/page-capture.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@titlesearch/cache": "workspace:*",
    "@titlesearch/core": "workspace:*",
    "puppeteer-core": "25.12.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
