{
  "name": "@titlesearch/providers",
  "version": "0.0.0",
  "description": "Read-only availability providers: RDAP, upstream MCP, GoDaddy, Porkbun, Name.com, DoH.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./whois/node": "./src/whois/node.ts",
    "./whois/workers": "./src/whois/workers.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:canary": "vitest run --config vitest.canary.config.ts"
  },
  "dependencies": {
    "@titlesearch/core": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
