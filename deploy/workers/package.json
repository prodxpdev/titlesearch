{
  "name": "@titlesearch/workers",
  "version": "0.0.0",
  "description": "The Cloudflare Workers target: D1, Browser Rendering, and workers-oauth-provider.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "embed-ui": "node scripts/embed-ui.mjs",
    "typecheck": "node scripts/embed-ui.mjs && tsc --noEmit -p tsconfig.json",
    "test:workers": "node scripts/embed-ui.mjs && vitest run --config vitest.workers.config.ts",
    "build": "pnpm --filter @titlesearch/web build && node scripts/embed-ui.mjs && wrangler deploy --dry-run --outdir dist",
    "deploy": "pnpm --filter @titlesearch/web build && node scripts/embed-ui.mjs && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@titlesearch/cache": "workspace:*",
    "@titlesearch/core": "workspace:*",
    "@titlesearch/deploy": "workspace:*",
    "@titlesearch/providers": "workspace:*",
    "@titlesearch/render": "workspace:*",
    "@titlesearch/server": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20261001.1",
    "jose": "6.2.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.146.0"
  }
}
