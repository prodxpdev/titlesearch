{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["biome.json", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": [
        "DYNAMODB_ENDPOINT",
        "FIRESTORE_EMULATOR_HOST",
        "TITLESEARCH_REQUIRE_EMULATORS"
      ]
    },
    "test:workers": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:canary": {
      "cache": false
    }
  }
}
