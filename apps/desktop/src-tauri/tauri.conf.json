{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Titlesearch",
  "version": "0.2.0",
  "identifier": "com.prodxp.titlesearch",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'",
      "capabilities": []
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Check whether a name is free across domain extensions.",
    "longDescription": "Titlesearch checks name availability across domain extensions, reports who occupies the taken ones, and whether they compete with what you're naming. It's read-only, and it isn't a trademark search.",
    "copyright": "Copyright 2026 ProdXP LLC. Apache-2.0.",
    "license": "Apache-2.0",
    "externalBin": ["binaries/titlesearch"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY",
      "endpoints": ["https://github.com/prodxpdev/titlesearch/releases/latest/download/latest.json"]
    }
  }
}
