{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/fixtures",
      "!docs/design",
      "!**/src-tauri/target",
      "!apps/web/src/styles.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "style": {
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "zod": {
                "importNames": ["z"],
                "message": "Use `import * as z from \"zod\"`. The `z` re-export is undefined under Vitest on Bun; see docs/decisions/0005-core-foundations.md."
              }
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/**/*.ts",
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "deploy/**/*.ts",
        "!packages/core/src/net/**",
        "!apps/web/src/api.ts"
      ],
      "plugins": ["./tools/biome-plugins/no-direct-fetch.grit"]
    },
    {
      "includes": [
        "packages/**/*.ts",
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "deploy/**/*.ts",
        "!packages/core/src/net/**",
        "!packages/core/src/extract/**",
        "!packages/server/src/static/**",
        "!**/test/**",
        "!**/test-canary/**",
        "!**/e2e/**"
      ],
      "plugins": ["./tools/biome-plugins/no-raw-site-content.grit"]
    },
    {
      "includes": ["packages/**/*.ts", "apps/cli/**/*.ts", "deploy/**/*.ts", "!**/test/**"],
      "plugins": ["./tools/biome-plugins/no-write-operations.grit"]
    },
    {
      "includes": ["packages/core/**/*.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*", "bun", "bun:*", "cloudflare:*", "@types/node"],
                    "message": "packages/core is runtime-agnostic: use fetch, Web Crypto, URL, and injected interfaces only."
                  }
                ],
                "paths": {
                  "zod": {
                    "importNames": ["z"],
                    "message": "Use `import * as z from \"zod\"`. The `z` re-export is undefined under Vitest on Bun; see docs/decisions/0005-core-foundations.md."
                  }
                }
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "process": "packages/core is runtime-agnostic. Inject config instead of reading process.",
                  "Buffer": "Use Uint8Array and TextEncoder/TextDecoder.",
                  "require": "ESM only.",
                  "__dirname": "No file system in core.",
                  "__filename": "No file system in core.",
                  "Bun": "packages/core is runtime-agnostic.",
                  "Deno": "packages/core is runtime-agnostic.",
                  "setImmediate": "Use setTimeout or queueMicrotask."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/views/Results.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off"
          }
        }
      }
    }
  ]
}
